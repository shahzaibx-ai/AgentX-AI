# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]
SYSTEM_PROMPT="You are a helpful, accurate and concise AI assistant. Use Markdown when it helps readability."

# Try cloud providers when no local model is installed or a local model fails
ALLOW_CLOUD_FALLBACK=true
MODEL_CACHE_TTL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=120

# ---------- Local AI (first priority) ----------
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434

# ---------- Cloud AI (fallback) ----------
# A provider is enabled as soon as its API key is set.
# Order in which cloud providers are tried:
CLOUD_PRIORITY=["anthropic","openai","gemini","grok","meta"]

# *_MODEL is the preferred model for automatic fallback. Leave empty to use
# the first model the provider lists. Users can still pick any model in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

GROK_API_KEY=
GROK_MODEL=

META_API_KEY=
META_MODEL=

# ---------- Voice mode (LiveKit) ----------
# Voice is enabled when all three are set. Use the same project as the agent.
# LIVEKIT_URL must be reachable from the browser (e.g. wss://<project>.livekit.cloud).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match VOICE_AGENT_NAME in agent/.env
VOICE_AGENT_NAME=my-agent
# Shared secret the agent sends to /api/voice/chat (same value in agent/.env). Empty = off.
# Set it whenever the API is reachable from the internet:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_AGENT_TOKEN=
# Optional voice picker (ids passed to the agent's TTS). Leave [] to use the agent default.
# VOICE_VOICES=[{"id":"calm","name":"Calm","description":"Even and relaxed","tts_voice":"<tts voice id>"}]
VOICE_VOICES=[]

# ---------- Photos ----------
# Limits the API enforces (the web app reads them from /api/models).
MAX_IMAGES_PER_MESSAGE=5
MAX_IMAGES_PER_REQUEST=20
MAX_IMAGE_BYTES=10485760
# Ollama reports which models can see images. Cloud models are matched by name;
# add patterns here for any the rules miss, e.g. ["my-org/*-vl"].
VISION_MODELS=[]
