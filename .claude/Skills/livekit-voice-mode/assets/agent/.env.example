# ---------- LiveKit (same project as the API) ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match VOICE_AGENT_NAME in api/.env
VOICE_AGENT_NAME=my-agent

# ---------- Brain ----------
# "app" = reply through the app's API: same model dropdown, Ollama first, cloud fallback.
# Or a LiveKit Inference model id to bypass the app, e.g. google/gemma-4-31b-it
VOICE_LLM=app
# Where the agent reaches the API (Docker Compose sets http://api:8000)
API_URL=http://localhost:8000
API_TIMEOUT_SECONDS=120
# Shared secret for /api/voice/chat; must equal VOICE_AGENT_TOKEN in api/.env (empty = off)
VOICE_AGENT_TOKEN=

# ---------- Speech (LiveKit Inference) ----------
VOICE_STT_MODEL=assemblyai/universal-3-5-pro
VOICE_STT_LANGUAGE=en
VOICE_TTS_MODEL=fishaudio/s2.1-pro
# Default voice. The web app's voice picker (VOICE_VOICES in api/.env) can override it per session.
VOICE_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
# ai-coustics noise cancellation on the user's microphone
VOICE_NOISE_CANCELLATION=true

# ---------- Personality ----------
# Spoken when a session starts. Leave empty to wait for the user to speak first.
VOICE_GREETING=Hi! What can I help you with?
# VOICE_INSTRUCTIONS=You are a helpful voice assistant...   (see settings.py for the default)
