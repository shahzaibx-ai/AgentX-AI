# Copy to .env and adjust. Every setting is optional; the defaults run all four models.
# Lists and dicts are JSON.

# development | production (production hides /docs and /openapi.json).
# Default: development; the Docker image sets production.
# ENVIRONMENT=development
# Origins allowed to call the API directly (the web app proxies /api, so this is only for other clients)
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Models ----------
# Default: distilbert/distilbert-base-uncased-finetuned-sst-2-english
# DEFAULT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
# Limit which models are offered (default: all four)
# ENABLED_MODELS=["distilbert/distilbert-base-uncased-finetuned-sst-2-english","ProsusAI/finbert","cardiffnlp/twitter-roberta-base-sentiment-latest","nlptown/bert-base-multilingual-uncased-sentiment"]
# Loaded in the background at startup (others load on first use). [] = none.
# PRELOAD_MODELS=["distilbert/distilbert-base-uncased-finetuned-sst-2-english"]
# Serve a model from a local folder instead of the Hugging Face Hub
# MODEL_SOURCES={"ProsusAI/finbert": "/srv/models/finbert"}
# Where downloaded models are cached (default: the Hugging Face cache, ~/.cache/huggingface)
# MODEL_CACHE_DIR=
# After `uv run python -m app.download`, run without network access:
# HF_HUB_OFFLINE=1

# ---------- Runtime ----------
# auto picks CUDA, then Apple MPS, then CPU
DEVICE=auto
# TORCH_THREADS=4
MAX_LENGTH=512
BATCH_SIZE=32

# ---------- Limits ----------
MAX_TEXT_CHARS=5000
MAX_BATCH_ITEMS=1000

# ---------- Explanations ----------
# Integrated-gradients steps for word influence (0 turns explanations off)
EXPLAIN_STEPS=16
# Predictions below this confidence are flagged for review in the UI
LOW_CONFIDENCE=0.6
